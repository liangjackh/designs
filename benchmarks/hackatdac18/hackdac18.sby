[options]
#mode bmc
depth 50
# 如果你想做全局证明，可以取消下面两行的注释，并注释掉上面的 bmc 配置
mode prove

[engines]
# 推荐使用 smtbmc 引擎配合 boolector 或 z3 求解器
#smtbmc boolector
# 如果是 prove 模式，通常使用 abc pdr:
abc pdr

